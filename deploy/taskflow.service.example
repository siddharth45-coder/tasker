[Unit]
Description=TaskFlow Flask application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tasker
EnvironmentFile=/etc/taskflow/taskflow.env
ExecStart=/var/www/tasker/.venv/bin/gunicorn -c /var/www/tasker/gunicorn.conf.py app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
